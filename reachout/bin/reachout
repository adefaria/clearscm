#!/usr/bin/perl

use strict;
use warnings;
binmode(STDOUT, ":utf8");
binmode(STDERR, ":utf8");

use FindBin;
use lib "/opt/clearscm/reachout/lib";
use lib "$FindBin::Bin/../lib";
use lib "/opt/clearscm/lib";

use Getopt::Long qw(:config no_ignore_case bundling);
use Pod::Usage;
use JSON::PP;
use Data::Dumper;

use Reachout::Config;
use Reachout::Policy;
use Reachout::State;
use Reachout::Template;
use Reachout::Engine;

my $env;
my $dry_run = 0;
my $verbose = 0;
my $help = 0;
my $to;
my $template;
my $contact;
my $venue;
my $issue;
my $message;
my $pol;
my $reason;
my $status;
my $file;

my $cmd = shift @ARGV || 'help';

GetOptions(
    'env=s'      => \$env,
    'dry-run'    => \$dry_run,
    'verbose|v'  => \$verbose,
    'help|h'     => \$help,
    'to=s'       => \$to,
    'template=s' => \$template,
    'contact=s'  => \$contact,
    'venue=s'    => \$venue,
    'issue=s'    => \$issue,
    'message=s'  => \$message,
    'policy=s'   => \$pol,
    'reason=s'   => \$reason,
    'status=s'   => \$status,
    'file=s'     => \$file,
);

if ($help || $cmd eq 'help') {
    print << "USAGE";
Usage: reachout <command> [options]

Commands:
  run                         Process scheduled reachouts for all active contacts
  send-test                   Send an immediate test email for a specified template
  list                        List all contacts and current campaign status
  status <id>                 Display detailed reachout history for a target
  pause <id> [--reason "msg"] Pause an active reachout sequence (e.g. on MAPS reply)
  resume <id>                 Resume a paused reachout sequence
  schedule <id> <date>        Set next run time for a target (YYYY-MM-DD [HH:MM:SS])
  close <id> [--status st]    Close a reachout (booked, declined, completed)
  add                         Add target(s) via --file <path> or CLI flags

Options:
  --env [staging|production]  Override detected environment target
  --dry-run                   Simulate execution without sending email or changing state
  --verbose                   Print detailed progress and log messages
  --to <email>                Destination email address for test messages
  --template <name>           Template to test (rockready_club, personal_job, support_vendor)
  --contact <name>            Contact person name
  --venue <venue>             Venue or organization name
  --issue <text>              Follow-up issue or topic headline (support_vendor)
  --message <text>            Main body / gripe text (support_vendor)
  --policy <passive|aggressive> Schedule policy (defaults to passive or aggressive)
USAGE
    exit 0;
}

my $config   = Reachout::Config->new(env => $env);
my $policy   = Reachout::Policy->new();
my $state    = Reachout::State->new(state_file => $config->get('state_file'));
my $tpl      = Reachout::Template->new();
my $engine   = Reachout::Engine->new(
    config   => $config,
    policy   => $policy,
    state    => $state,
    template => $tpl,
);
$engine->{verbose} = $verbose;

print "Reachout Subsystem [Env: " . $config->env() . "]\n" if $verbose;

if ($cmd eq 'send-test') {
    $template ||= 'rockready_club';
    $to       ||= $config->get('test_recipient') || 'Andrew@DeFaria.com';
    $contact  ||= 'Andrew DeFaria';
    
    if ($template eq 'rockready_club') {
        $venue ||= 'Belly Up Tavern';
    } elsif ($template eq 'personal_job') {
        $venue ||= 'Google Cloud Infrastructure';
    } else {
        $venue   ||= 'Vendor Support Desk';
        $issue   ||= 'Bug Report #8492 — API Gateway Connection Timeout';
        $message ||= "I haven't heard back regarding the timeout issue reported last week. Could you please check on the status and let me know when we might expect a fix?";
    }
    
    my $mock_id = "test-" . $template . "-" . time();
    my $target = {
        id        => $mock_id,
        contact   => $contact,
        venue     => $venue,
        email     => $to,
        template  => $template,
        policy    => $pol || ($template eq 'support_vendor' ? 'aggressive' : 'passive'),
        issue     => $issue,
        message   => $message,
    };
    
    print "Sending test email:\n";
    print "  Template : $template\n";
    print "  To       : $to\n";
    print "  Contact  : $contact\n";
    print "  Issue    : $issue\n" if $issue;
    print "  Mode     : " . ($dry_run ? "DRY-RUN" : "LIVE SMTP") . "\n";
    
    my $res = $engine->dispatch_target($target, dry_run => $dry_run, force_to => $to, force_attempt => 1);
    if ($res->{success}) {
        print "SUCCESS: Dispatched test email [Message-ID: $res->{message_id}]\n";
        print "Subject: $res->{subject}\n";
    } else {
        print "FAILED: $res->{reason}\n";
    }
} elsif ($cmd eq 'add') {
    my $contacts_file = $config->get('contacts_file');
    my @new_targets;
    
    if ($file) {
        open my $fh, '<:raw', $file or die "Cannot open $file: $!";
        local $/;
        my $data = JSON::PP->new->utf8->decode(<$fh>);
        close $fh;
        @new_targets = @$data;
    } elsif ($to || $contact || $issue) {
        die "Error: --to <email> is required when adding a contact via CLI\n" unless $to;
        my $new_id = "target-" . time();
        push @new_targets, {
            id       => $new_id,
            contact  => $contact || "Contact",
            email    => $to,
            venue    => $venue || "General",
            template => $template || "support_vendor",
            policy   => $pol || "passive",
            issue    => $issue || "Follow-up",
            message  => $message || "Following up on our conversation.",
            status   => "active",
        };
    } else {
        die "Usage: reachout add --file <path.json> OR reachout add --to <email> --contact <name> --issue <issue> --message <text>\n";
    }
    
    # Load existing contacts
    my $existing = [];
    if (-r $contacts_file) {
        open my $fh, '<:raw', $contacts_file or die "Cannot open $contacts_file: $!";
        local $/;
        $existing = JSON::PP->new->utf8->decode(<$fh>);
        close $fh;
    }
    
    push @$existing, @new_targets;
    
    open my $fh, '>:raw', $contacts_file or die "Cannot write $contacts_file: $!";
    print $fh JSON::PP->new->utf8->pretty->canonical->encode($existing);
    close $fh;
    
    print "Successfully added " . scalar(@new_targets) . " target(s) to $contacts_file\n";
} elsif ($cmd eq 'run') {
    my $contacts_file = $config->get('contacts_file');
    die "Contacts file not found: $contacts_file\n" unless -r $contacts_file;
    
    open my $fh, '<:raw', $contacts_file or die "Cannot open $contacts_file: $!";
    local $/;
    my $contacts_data = JSON::PP->new->utf8->decode(<$fh>);
    close $fh;
    
    my $count = 0;
    my $now = time();
    
    for my $target (@$contacts_data) {
        my $id = $target->{id};
        my $entry = $state->get_target($id);
        
        # Check schedule if already has history
        if ($entry && $entry->{next_run_epoch}) {
            if ($now < $entry->{next_run_epoch}) {
                print "Skipping '$id' (Next scheduled run: $entry->{next_run_date})\n" if $verbose;
                next;
            }
        }
        
        print "Processing contact target: $id ($target->{contact} @ $target->{venue})\n";
        my $res = $engine->dispatch_target($target, dry_run => $dry_run);
        if ($res->{success}) {
            print "  -> Sent Attempt [Message-ID: $res->{message_id}]\n";
            $count++;
        }
    }
    print "Reachout run complete. Processed $count messages.\n";
} elsif ($cmd eq 'list') {
    my $contacts_file = $config->get('contacts_file');
    my %all_ids;
    my %contact_map;
    if (-r $contacts_file) {
        open my $fh, '<:raw', $contacts_file or die "Cannot open $contacts_file: $!";
        local $/;
        my $contacts_data = JSON::PP->new->utf8->decode(<$fh>);
        close $fh;
        for my $c (@$contacts_data) {
            $all_ids{$c->{id}} = 1;
            $contact_map{$c->{id}} = $c;
        }
    }
    my $targets = $state->all_targets();
    for my $id (keys %$targets) {
        $all_ids{$id} = 1;
    }
    print sprintf("%-18s %-20s %-20s %-8s %-10s %-19s\n", "TARGET ID", "VENUE", "CONTACT", "ATTEMPTS", "STATUS", "NEXT RUN");
    print "-" x 100 . "\n";
    for my $id (sort keys %all_ids) {
        my $t = $targets->{$id};
        my $c = $contact_map{$id} || {};
        my $venue = $c->{venue} || $id;
        my $contact = $c->{contact} || ($t && $t->{history}[-1]{recipient}) || 'Unknown';
        my $attempts = $t ? $t->{attempts} : 0;
        my $st = $t ? $t->{status} : ($c->{status} || 'active');
        my $next = $t ? ($t->{next_run_date} || 'None') : 'Pending (Ready)';
        print sprintf("%-18s %-20s %-20s %-8s %-10s %-19s\n", $id, substr($venue, 0, 19), substr($contact, 0, 19), $attempts, $st, $next);
    }
} elsif ($cmd eq 'status') {
    my $id = shift @ARGV or die "Usage: reachout status <target_id>\n";
    my $t = $state->get_target($id);
    if (!$t) {
        die "Target '$id' not found in state.\n";
    }
    print "Reachout Target: $id\n";
    print "  Status        : $t->{status}\n";
    print "  Attempts Sent : $t->{attempts}\n";
    print "  Last Attempt  : " . ($t->{last_attempt_date} || 'None') . "\n";
    print "  Next Run Date : " . ($t->{next_run_date} || 'None') . "\n";
    if ($t->{status_reason}) {
        print "  Status Reason : $t->{status_reason}\n";
    }
    print "\nHistory:\n";
    for my $h (@{$t->{history} || []}) {
        print "  [Attempt $h->{attempt} - $h->{date}]\n";
        print "    To         : $h->{recipient}\n";
        print "    Subject    : $h->{subject}\n";
        print "    Message-ID : $h->{message_id}\n";
    }
} elsif ($cmd eq 'pause') {
    my $id = shift @ARGV or die "Usage: reachout pause <target_id> [--reason text]\n";
    if ($state->set_status($id, 'paused', $reason || 'Manually paused')) {
        print "Target '$id' paused.\n";
    } else {
        print "Target '$id' not found in state.\n";
    }
} elsif ($cmd eq 'resume') {
    my $id = shift @ARGV or die "Usage: reachout resume <target_id>\n";
    if ($state->set_status($id, 'active', 'Resumed campaign')) {
        print "Target '$id' resumed.\n";
    } else {
        print "Target '$id' not found in state.\n";
    }
} elsif ($cmd eq 'close') {
    my $id = shift @ARGV or die "Usage: reachout close <target_id> [--status booked|completed|declined]\n";
    $status ||= 'completed';
    if ($state->set_status($id, $status, $reason || "Closed with status $status")) {
        print "Target '$id' marked as '$status'.\n";
    } else {
        print "Target '$id' not found in state.\n";
    }
} elsif ($cmd eq 'schedule') {
    my $id = shift @ARGV or die "Usage: reachout schedule <target_id> <YYYY-MM-DD [HH:MM:SS] | epoch>\n";
    my $date_str = join(' ', @ARGV);
    die "Usage: reachout schedule <target_id> <YYYY-MM-DD [HH:MM:SS] | epoch>\n" unless $date_str;
    
    my $epoch;
    if ($date_str =~ /^\d+$/) {
        $epoch = $date_str;
    } elsif ($date_str =~ /^(\d{4})-(\d{2})-(\d{2})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?)?$/) {
        my ($y, $m, $d, $h, $min, $sec) = ($1, $2, $3, $4 // 9, $5 // 0, $6 // 0);
        use POSIX qw(mktime);
        $epoch = mktime($sec, $min, $h, $d, $m - 1, $y - 1900);
    } else {
        die "Error: Invalid date format '$date_str'. Use 'YYYY-MM-DD' or 'YYYY-MM-DD HH:MM:SS'\n";
    }
    
    my $t = $state->set_next_run($id, $epoch);
    print "Scheduled '$id' for next run at: $t->{next_run_date}\n";
} else {
    die "Unknown command: $cmd (use 'reachout help' for usage)\n";
}
