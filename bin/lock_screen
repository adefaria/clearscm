#!/bin/sh

# Pick a new random wallpaper for the login/lock screen
/opt/clearscm/bin/new_login_screen

# Switch to LightDM login/greeter screen
dm-tool switch-to-greeter

# Deactivate/unblank XScreenSaver so it resets idle timer and clears lock state
/usr/bin/xscreensaver-command -deactivate >/dev/null 2>&1

