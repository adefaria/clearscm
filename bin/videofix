#!/bin/bash

#-------------------------------------------------------------------------------
# SCRIPT: videofix
# DESCRIPTION: Smart video web-optimizer. Uses ffprobe to inspect and apply 
#              intelligent remuxing or controlled transcoding.
#
# USAGE: ./videofix [-H|-m|-l] <path/to/file.mp4 or .mov>
#   MODES:
#     -H : High Quality (DEFAULT - Smart remux if web-ready, or safe high-fidelity transcode)
#     -m : Medium Quality (Balanced middle-ground compression for sharing)
#     -l : Low Quality (Aggressive squeeze for quick band preview files)
#-------------------------------------------------------------------------------

# --- Defaults ---
QUALITY_MODE="high"

# --- Argument Parsing ---
while getopts "Hml" opt; do
    case ${opt} in
        H) QUALITY_MODE="high" ;;
        m) QUALITY_MODE="medium" ;;
        l) QUALITY_MODE="low" ;;
        *) 
           echo "Usage: $0 [-H|-m|-l] <path/to/file.mp4 or .mov>"
           exit 1 
           ;;
    esac
done
shift $((OPTIND -1))

if [ -z "$1" ]; then
    echo "Error: Missing input file argument."
    echo "Usage: $0 [-H|-m|-l] <path/to/file.mp4 or .mov>"
    exit 1
fi

INPUT_FILE="$1"

if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: File not found at '$INPUT_FILE'."
    exit 1
fi

# Determine final output filename (.MOV to .mp4 handling)
if [[ "$INPUT_FILE" =~ \.mov$ ]] || [[ "$INPUT_FILE" =~ \.MOV$ ]]; then
    FINAL_OUTPUT_FILE="${INPUT_FILE%.*}.mp4"
    echo "Input file is a .MOV file. Saving as $FINAL_OUTPUT_FILE."
else
    FINAL_OUTPUT_FILE="$INPUT_FILE"
fi

FILENAME=$(basename "$1")
TEMP_FILE="/tmp/${FILENAME%.*}.temp.mp4"
ERROR_LOG="ffmpeg_error.log"

NVENC_ENCODER="h264_nvenc"
SOFTWARE_ENCODER="libx264"
ENCODE_STATUS=1
ENCODER_USED=""

# --- Smart Inspection via ffprobe ---
SRC_V_CODEC=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$INPUT_FILE" 2>/dev/null)
SRC_PIX_FMT=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "$INPUT_FILE" 2>/dev/null)
SRC_A_CODEC=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$INPUT_FILE" 2>/dev/null)

echo "----------------------------------------------------------------------"
echo "Source Inspection: Video Codec: $SRC_V_CODEC | PixFmt: $SRC_PIX_FMT | Audio: $SRC_A_CODEC"
echo "----------------------------------------------------------------------"

# --- Execution Logic ---

if [ "$QUALITY_MODE" = "high" ] && [ "$SRC_V_CODEC" = "h264" ] && [ "$SRC_PIX_FMT" = "yuv420p" ] && [ "$SRC_A_CODEC" = "aac" ]; then
    echo "Mode: High Quality -> File is already web-compatible! Performing zero-loss remux."
    ffmpeg -i "$INPUT_FILE" -y -c:v copy -c:a copy -movflags +faststart "$TEMP_FILE" 2> "$ERROR_LOG"
    ENCODE_STATUS=$?
    ENCODER_USED="stream-copy (exact size/quality preserved)"
else
    # Configuration based on mode for transcoding
    if [ "$QUALITY_MODE" = "high" ]; then
        CRF_VAL="21"
        NV_CQ="21"
        MAX_BITRATE="8M"
        BUF_SIZE="16M"
        AUDIO_BITRATE="192k"
        echo "Mode: High Quality Transcode (High fidelity, web-compatible yuv420p)"
    elif [ "$QUALITY_MODE" = "medium" ]; then
        CRF_VAL="24"
        NV_CQ="24"
        MAX_BITRATE="4M"
        BUF_SIZE="8M"
        AUDIO_BITRATE="128k"
        echo "Mode: Medium Quality Transcode (Balanced size/quality)"
    else
        # Low: Preview mode for band members
        CRF_VAL="32"
        NV_CQ="32"
        MAX_BITRATE="600k"
        BUF_SIZE="1.2M"
        AUDIO_BITRATE="64k"
        echo "Mode: Low Quality Preview Transcode (Small file for screening)"
    fi

    PRESET_VALUE="medium"

    run_transcode() {
        local encoder=$1
        if [ "$encoder" = "$NVENC_ENCODER" ]; then
            ffmpeg -i "$INPUT_FILE" \
                   -y \
                   -c:v "$encoder" \
                   -preset "$PRESET_VALUE" \
                   -rc constqp \
                   -qp "$NV_CQ" \
                   -maxrate "$MAX_BITRATE" \
                   -bufsize "$BUF_SIZE" \
                   -pix_fmt yuv420p \
                   -c:a aac -b:a "$AUDIO_BITRATE" \
                   -movflags +faststart \
                   "$TEMP_FILE" 2> "$ERROR_LOG"
        else
            ffmpeg -i "$INPUT_FILE" \
                   -y \
                   -c:v "$encoder" \
                   -preset "$PRESET_VALUE" \
                   -crf "$CRF_VAL" \
                   -maxrate "$MAX_BITRATE" \
                   -bufsize "$BUF_SIZE" \
                   -pix_fmt yuv420p \
                   -c:a aac -b:a "$AUDIO_BITRATE" \
                   -movflags +faststart \
                   "$TEMP_FILE" 2> "$ERROR_LOG"
        fi
        return $?
    }

    # Try hardware acceleration first, fall back to software
    run_transcode "$NVENC_ENCODER"
    ENCODE_STATUS=$?
    ENCODER_USED="$NVENC_ENCODER"

    if [ $ENCODE_STATUS -ne 0 ]; then
        if grep -q "Cannot load libcuda.so.1" "$ERROR_LOG" || grep -q "Unknown encoder" "$ERROR_LOG" || grep -q "Error initializing output stream" "$ERROR_LOG"; then
            echo "Hardware encoder failed. Falling back to software encoding ($SOFTWARE_ENCODER)..."
            run_transcode "$SOFTWARE_ENCODER"
            ENCODE_STATUS=$?
            ENCODER_USED="$SOFTWARE_ENCODER"
        fi
    fi
fi

rm -f "$ERROR_LOG"

# --- Post-Processing Cleanup ---
if [ $ENCODE_STATUS -eq 0 ]; then
    echo "----------------------------------------------------------------------"
    echo "Success using: $ENCODER_USED"
    
    if [ "$INPUT_FILE" != "$FINAL_OUTPUT_FILE" ]; then
        mv -f "$TEMP_FILE" "$FINAL_OUTPUT_FILE"
        echo "✅ Success: Saved as '$FINAL_OUTPUT_FILE'."
    else
        echo "Replacing original file..."
        mv -f "$TEMP_FILE" "$INPUT_FILE"
        echo "✅ Success: '$INPUT_FILE' updated."
    fi
else
    echo "----------------------------------------------------------------------"
    echo "❌ Critical Error: Process failed (Status $ENCODE_STATUS)."
    [ -f "$TEMP_FILE" ] && rm -f "$TEMP_FILE"
    exit 1
fi

exit 0
