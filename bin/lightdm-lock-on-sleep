#!/usr/bin/env python3
"""Hold a systemd-logind sleep delay inhibitor and lock LightDM before suspend."""

import os
import signal
import subprocess
import sys
import time
import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

LOGIN1_BUS = "org.freedesktop.login1"
LOGIN1_PATH = "/org/freedesktop/login1"
LOGIN1_IFACE = "org.freedesktop.login1.Manager"
SESSION_IFACE = "org.freedesktop.login1.Session"
PROPS_IFACE = "org.freedesktop.DBus.Properties"
DEFAULT_SEAT_PATH = "/org/freedesktop/DisplayManager/Seat0"
GREETER_WAIT_TIMEOUT_S = 4.5


class SleepLocker:
    """Manage a sleep delay inhibitor and invoke dm-tool lock on PrepareForSleep."""

    def __init__(self) -> None:
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.inhibit_fd: int | None = None
        self.loop = GLib.MainLoop()

    def acquire_inhibitor(self) -> None:
        """Acquire a sleep delay inhibitor lock from systemd-logind."""
        if self.inhibit_fd is not None:
            return
        params = GLib.Variant(
            "(ssss)",
            ("sleep", "lightdm-lock-on-sleep", "Lock screen with LightDM before suspend", "delay"),
        )
        res, fd_list = self.bus.call_with_unix_fd_list_sync(
            LOGIN1_BUS,
            LOGIN1_PATH,
            LOGIN1_IFACE,
            "Inhibit",
            params,
            GLib.VariantType("(h)"),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
        )
        self.inhibit_fd = fd_list.get(res.unpack()[0])

    def release_inhibitor(self) -> None:
        """Release the sleep delay inhibitor lock so suspend can proceed."""
        if self.inhibit_fd is not None:
            try:
                os.close(self.inhibit_fd)
            except OSError:
                pass
            self.inhibit_fd = None

    def greeter_is_active(self) -> bool:
        """Return True if seat0 currently has an active LightDM greeter session."""
        res = self.bus.call_sync(
            LOGIN1_BUS,
            LOGIN1_PATH,
            LOGIN1_IFACE,
            "ListSessions",
            None,
            GLib.VariantType("(a(susso))"),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
        )
        for _sid, _uid, _user, seat, path in res.unpack()[0]:
            if seat != "seat0":
                continue
            props = self.bus.call_sync(
                LOGIN1_BUS,
                path,
                PROPS_IFACE,
                "GetAll",
                GLib.Variant("(s)", (SESSION_IFACE,)),
                GLib.VariantType("(a{sv})"),
                Gio.DBusCallFlags.NONE,
                -1,
                None,
            ).unpack()[0]
            if props.get("Class") == "greeter" and props.get("Active") is True:
                return True
        return False

    def on_prepare_for_sleep(
        self,
        _connection: Gio.DBusConnection,
        _sender: str,
        _path: str,
        _iface: str,
        _signal: str,
        parameters: GLib.Variant,
    ) -> None:
        """Lock the LightDM seat before suspend and re-arm the inhibitor on wake."""
        (going_to_sleep,) = parameters.unpack()
        if going_to_sleep:
            env = os.environ.copy()
            env.setdefault("XDG_SEAT_PATH", DEFAULT_SEAT_PATH)
            try:
                if not self.greeter_is_active():
                    subprocess.run(["/usr/bin/dm-tool", "lock"], env=env, timeout=4, check=False)
                    deadline = time.monotonic() + GREETER_WAIT_TIMEOUT_S
                    while time.monotonic() < deadline:
                        if self.greeter_is_active():
                            greeter_up = subprocess.run(
                                ["pgrep", "-u", "lightdm", "-x", "lightdm-gtk-greeter"],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                check=False,
                            )
                            if greeter_up.returncode == 0:
                                # Allow lightdm-gtk-greeter and its D-Bus/AT-SPI services
                                # to finish drawing before suspend freezes user space.
                                remaining = deadline - time.monotonic()
                                time.sleep(min(1.0, max(0.2, remaining)))
                                break
                        time.sleep(0.1)
            except Exception as exc:
                print(f"dm-tool lock failed: {exc}", file=sys.stderr, flush=True)
            finally:
                self.release_inhibitor()
        else:
            self.acquire_inhibitor()

    def run(self) -> None:
        """Subscribe to PrepareForSleep and enter the GLib main loop."""
        self.acquire_inhibitor()
        self.bus.signal_subscribe(
            LOGIN1_BUS,
            LOGIN1_IFACE,
            "PrepareForSleep",
            LOGIN1_PATH,
            None,
            Gio.DBusSignalFlags.NONE,
            self.on_prepare_for_sleep,
        )
        for sig in (signal.SIGINT, signal.SIGTERM):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, self._shutdown)
        self.loop.run()

    def _shutdown(self) -> bool:
        self.release_inhibitor()
        self.loop.quit()
        return False


if __name__ == "__main__":
    SleepLocker().run()
