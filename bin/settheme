#!/bin/bash
DARK_ENGINE="MyDarkTheme"
LIGHT_ENGINE="MyLightTheme"
LAT="33.12"
LON="-117.29"
HELIOCRON="/usr/local/bin/heliocron"
COLOR_CHOOSER="$HOME/.gtkrc-2.0-gnome-color-chooser"
HOSTNAME=$(hostname)

is_x11_available() {
    export DISPLAY="${DISPLAY:-:0}"
    export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
    xset q >/dev/null 2>&1
}

is_session_active() {
    if command -v loginctl >/dev/null 2>&1; then
        local sess_id
        sess_id=$(loginctl show-user "$USER" -p Display --value 2>/dev/null | cut -d: -f1)
        if [ -n "$sess_id" ]; then
            local active_state
            active_state=$(loginctl show-session "$sess_id" -p Active --value 2>/dev/null)
            if [ "$active_state" = "no" ]; then
                return 1
            fi
        fi
    fi
    if xscreensaver-command -time 2>/dev/null | grep -q "screen locked"; then
        return 1
    fi
    return 0
}

restart_or_start_panel() {
    local PENDING_RESTART="$HOME/.cache/settheme_pending_panel_restart"
    mkdir -p "$HOME/.cache"

    if ! is_x11_available || ! is_session_active; then
        touch "$PENDING_RESTART"
        return 0
    fi

    rm -f "$PENDING_RESTART"

    local SESSION_MGR=""
    local mate_pid=$(pgrep -u "$USER" -x mate-session | head -n 1)
    if [ -n "$mate_pid" ] && [ -r "/proc/$mate_pid/environ" ]; then
        SESSION_MGR=$(tr '\0' '\n' < "/proc/$mate_pid/environ" | grep '^SESSION_MANAGER=' | cut -d= -f2-)
    fi

    # Build systemd-run env args — DISPLAY and XAUTHORITY are critical for X11
    local -a env_args=()
    [ -n "$DISPLAY" ]    && env_args+=(--setenv="DISPLAY=$DISPLAY")
    [ -n "$XAUTHORITY" ] && env_args+=(--setenv="XAUTHORITY=$XAUTHORITY")
    [ -n "$SESSION_MGR" ] && env_args+=(--setenv="SESSION_MANAGER=$SESSION_MGR")

    if pgrep -u "$USER" -x mate-panel >/dev/null 2>&1; then
        if command -v systemd-run >/dev/null 2>&1 && [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
            systemd-run --user "${env_args[@]}" mate-panel --replace >/dev/null 2>&1
        else
            setsid mate-panel --replace >/dev/null 2>&1 &
        fi
    else
        echo "mate-panel is not running. Starting mate-panel..."
        if command -v systemd-run >/dev/null 2>&1 && [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
            systemd-run --user "${env_args[@]}" mate-panel >/dev/null 2>&1
        else
            setsid mate-panel >/dev/null 2>&1 &
        fi
    fi

    # Ensure the newly created panel windows are raised above the Caja desktop canvas
    (
        sleep 1
        if command -v xdotool >/dev/null 2>&1 && [ -n "$DISPLAY" ]; then
            xdotool search --class "mate-panel" windowraise 2>/dev/null || true
        fi
    ) >/dev/null 2>&1 &
}

set_mode() {
    local mode=$1
    local force=$2
    local engine
    local pref
    local PENDING_RESTART="$HOME/.cache/settheme_pending_panel_restart"

    if [ "$mode" == "dark" ]; then
        engine="$DARK_ENGINE"
        pref="prefer-dark"
    else
        engine="$LIGHT_ENGINE"
        pref="prefer-light"
    fi

    local panel_running=true
    if ! pgrep -u "$USER" -x mate-panel >/dev/null 2>&1; then
        panel_running=false
    fi

    # Check if already in the requested mode
    CURRENT=$(gsettings get org.mate.interface gtk-theme 2>/dev/null | tr -d "'" | xargs)
    if [ "$force" != "true" ] && [ "$CURRENT" == "$engine" ] && [ "$panel_running" = true ] && [ ! -f "$PENDING_RESTART" ]; then
        echo "Already in $mode mode ($engine). No change needed."
        return 0
    fi

    # If the theme matches but panel is missing or pending restart, just fix the panel
    if [ "$force" != "true" ] && [ "$CURRENT" == "$engine" ]; then
        echo "Theme is already $mode ($engine), ensuring panel is running cleanly..."
        restart_or_start_panel
        return 0
    fi

    if [ "$mode" == "dark" ]; then
        # Restore AntiGravity's blue tint if a backup exists
        if [ -f "${COLOR_CHOOSER}.bak" ]; then
            mv "${COLOR_CHOOSER}.bak" "$COLOR_CHOOSER"
        fi
    else
        engine="$LIGHT_ENGINE"
        pref="prefer-light"
        # Hide AntiGravity's blue tint so Light Mode isn't "stained"
        if [ -f "$COLOR_CHOOSER" ]; then
            mv "$COLOR_CHOOSER" "${COLOR_CHOOSER}.bak"
        fi
        # Signal to Brave/GTK3 apps to use Light variants
        sed -i 's/gtk-application-prefer-dark-theme=1/gtk-application-prefer-dark-theme=0/g' ~/.config/gtk-3.0/settings.ini

        # CLEAR CACHE: This is the missing link for AntiGravity
        # It forces MATE to stop "remembering" the blue color-scheme
        gsettings set org.mate.interface gtk-color-scheme ''

        # Force GTK2 (AntiGravity) to realize the blue config is gone
        export GTK2_RC_FILES="$HOME/.gtkrc-2.0"
        gsettings reset org.mate.interface gtk-color-scheme
    fi

    echo "Switching to $mode ($engine)..."

    # 1. Update GSettings (MATE & GNOME)
    gsettings set org.mate.interface gtk-theme "$engine"
    gsettings set org.gnome.desktop.interface gtk-theme "$engine"
    gsettings set org.gnome.desktop.interface color-scheme "$pref"

    # 2. Broadcast the change via DBus / XSettings
    dbus-send --session --dest=org.mate.SettingsDaemon \
        --type=method_call /org/mate/SettingsDaemon/Plugins/XSettings \
        org.mate.SettingsDaemon.Plugins.XSettings.SetString \
        string:"Net/ThemeName" string:"$engine"

    # 3. Brave/Chromium "Nudge"
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
    sleep 0.1
    gsettings set org.gnome.desktop.interface color-scheme "$pref"
    
    # 4. Emerald Reload (Graceful, no-flash)
    if pgrep -x "emerald" > /dev/null; then
        dbus-send --type=method_call --dest=org.beryl_project.emerald \
            /org/beryl_project/emerald org.beryl_project.emerald.reload_settings
    fi

    # 5. Clean up legacy panel override CSS if present
    if [ -f "$HOME/.config/gtk-3.0/gtk.css" ] && grep -q "mate-panel" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null; then
        rm -f "$HOME/.config/gtk-3.0/gtk.css"
    fi

    # 6. Restart MATE panel or queue pending restart if screen is locked / X11 unreachable
    restart_or_start_panel
}

case "$1" in
    -n|--night) set_mode "dark"  ;;
    -d|--day)   set_mode "light" ;;
    -f|--force)
        if $HELIOCRON --latitude $LAT --longitude $LON poll | grep -q "Day"; then
            set_mode "light" "true"
        else
            set_mode "dark" "true"
        fi
        ;;
    -t|--toggle)
        CURRENT=$(gsettings get org.mate.interface gtk-theme | tr -d "'" | xargs)
        if [ "$CURRENT" == "$DARK_ENGINE" ]; then
            set_mode "light"
        else
            set_mode "dark"
        fi
        ;;
    "")
        if $HELIOCRON --latitude $LAT --longitude $LON poll | grep -q "Day"; then
            set_mode "light"
        else
            set_mode "dark"
        fi
        ;;
    *)
        echo "Usage: $(basename "$0") [-t|--toggle] [-d|--day] [-n|--night] [-f|--force]"
        exit 1
        ;;
esac

