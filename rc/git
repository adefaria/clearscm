function in_git_repo {
  pwd=$PWD
  
  while [ "$pwd" != "/" -a "$pwd" != "//" ]; do
    if [ -d "$pwd/.git" ]; then
      true;
      return;
    fi

    pwd=$(dirname "$pwd")
  done
  
  false
} # in_git_repo

is_repo_clean() {
  local repo="${1:-.}"
  (
    cd "$repo" || return 1

    # Uncommitted or untracked changes
    [ -z "$(git status --porcelain)" ] || return 1

    # Upstream ahead/behind divergence
    if git rev-parse --verify --quiet @{u} >/dev/null 2>&1; then
      local counts
      counts=$(git rev-list --left-right --count HEAD...@{u} 2>/dev/null)
      [ "$counts" = "$(printf '0\t0')" ] || return 1
    fi

    return 0
  )
} # is_repo_clean

function git () {
  # Need to reset title since we put the branch name in the titlebar
  git=$(/usr/bin/which git)

  if [ "${git:0:3}" != "no " ]; then
    if [ "$1" = "checkout" -o "$1" = "co" ]; then
      $git "$@"
      set_title
    else
      $git "$@"
    fi
  fi
} # git
